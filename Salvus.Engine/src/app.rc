#include <winver.h>

// Official Salvus application icon referenced directly from repository root
101 ICON "../../Salvus.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Salvus Contributors"
            VALUE "FileDescription", "Salvus Native Data Recovery Engine"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "Salvus.Engine"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "Salvus.Engine.exe"
            VALUE "ProductName", "Salvus"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
