<Window x:Class="Salvus.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Salvus.Desktop.ViewModels"
        Title="Salvus — Recover what matters."
        Icon="pack://application:,,,/Assets/Salvus.ico"
        Width="1240"
        Height="780"
        MinWidth="1024"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindowBrush}">

  <Window.Resources>
    <!-- 1. Dashboard -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,16">
          <!-- Branding & Engine Banner -->
          <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Image Source="pack://application:,,,/Assets/Salvus.png"
                     Width="56"
                     Height="56"
                     Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     Margin="0,0,16,0"
                     VerticalAlignment="Center" />

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Salvus" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Recover what matters." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding DevelopmentPhase}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0" />
              </StackPanel>

              <Button Grid.Column="2"
                      Content="Refresh Engine Status"
                      Command="{Binding RefreshCommand}"
                      Style="{StaticResource SecondaryButtonStyle}"
                      VerticalAlignment="Center" />
            </Grid>
          </Border>

          <!-- Key Diagnostics Row -->
          <UniformGrid Columns="3" Margin="0,0,0,12">
            <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,6,0">
              <StackPanel>
                <TextBlock Text="ENGINE PROCESS (IPC)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="{Binding EngineStatusText}" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,2" TextWrapping="Wrap" />
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                  <Run Text="Version: " />
                  <Run Text="{Binding EngineVersion, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0">
                  <Run Text="Last Ping UTC: " />
                  <Run Text="{Binding LastPingUtc, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}" Margin="6,0,6,0">
              <StackPanel>
                <TextBlock Text="CONNECTED STORAGE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,6,0,2">
                  <Run Text="{Binding PhysicalDiskCount, Mode=OneWay}" />
                  <Run Text=" Physical Disk(s) · " />
                  <Run Text="{Binding VolumeCount, Mode=OneWay}" />
                  <Run Text=" Volume(s)" />
                </TextBlock>
                <TextBlock Text="{Binding StorageAccessSummary}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}" Margin="6,0,0,0">
              <StackPanel>
                <TextBlock Text="PERSISTED ACTIVITY (SQLITE)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,6,0,2">
                  <Run Text="{Binding RecentScanCount, Mode=OneWay}" />
                  <Run Text=" Scan Sessions" />
                </TextBlock>
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                  <Run Text="{Binding RecentRecoveryCount, Mode=OneWay}" />
                  <Run Text=" Recovery Operations Recorded" />
                </TextBlock>
              </StackPanel>
            </Border>
          </UniformGrid>

          <!-- Live Engine Capabilities Table -->
          <Border Style="{StaticResource PanelBorderStyle}">
            <StackPanel>
              <TextBlock Text="Engine Module Readiness (Reported Live via Named Pipes)"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Margin="0,0,0,10" />
              <ItemsControl ItemsSource="{Binding Capabilities}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="220" />
                          <ColumnDefinition Width="100" />
                          <ColumnDefinition Width="140" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Phase}" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontWeight="SemiBold">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Implemented}" Value="True">
                                  <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="3" Text="{Binding Notes}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!-- 2. Drives -->
    <DataTemplate DataType="{x:Type vm:DrivesViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,16">
          <!-- Status & Refresh Bar -->
          <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
            <DockPanel>
              <Button DockPanel.Dock="Right"
                      Content="Refresh Devices"
                      Command="{Binding RefreshCommand}"
                      Style="{StaticResource SecondaryButtonStyle}"
                      VerticalAlignment="Center" />
              <TextBlock Text="{Binding StatusMessage}"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         Margin="0,0,12,0" />
            </DockPanel>
          </Border>

          <!-- Physical Disks Section -->
          <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Physical Storage Devices" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBlock Text="Entire physical drives (never confused with logical partitions). Opened strictly read-only."
                         Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10" />

              <!-- Header Row -->
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="85" />
                  <ColumnDefinition Width="105" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="DEVICE / MODEL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="1" Text="TYPE / BUS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="2" Text="CAPACITY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="3" Text="LAYOUT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="4" Text="SECTOR" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="5" Text="ACCESS / PATH" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
              </Grid>

              <ItemsControl ItemsSource="{Binding PhysicalDisks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="220" />
                          <ColumnDefinition Width="130" />
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="85" />
                          <ColumnDefinition Width="105" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding DevicePath}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding DeviceType}" />
                          <TextBlock Text="{Binding ConnectionType}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding CapacityFormatted}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding PartitionLayout}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}">
                          <Run Text="{Binding SectorSizeBytes, Mode=OneWay}" />
                          <Run Text=" B" />
                        </TextBlock>
                        <TextBlock Grid.Column="5" Text="{Binding HealthStatus}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Logical Volumes & Partitions Section -->
          <Border Style="{StaticResource PanelBorderStyle}">
            <StackPanel>
              <TextBlock Text="Logical Volumes &amp; Partitions" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBlock Text="Mounted and unmounted file-system volumes mapped to their parent physical disks."
                         Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10" />

              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="VOLUME" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="1" Text="FILE SYSTEM" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="2" Text="CAPACITY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="3" Text="AVAILABLE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="4" Text="PARENT DISK" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="5" Text="VOLUME GUID PATH" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
              </Grid>

              <ItemsControl ItemsSource="{Binding Volumes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="200" />
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="130" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding FileSystem}" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding TotalFormatted}" />
                        <TextBlock Grid.Column="3" Text="{Binding AvailableFormatted}" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="{Binding ParentDiskDisplay}" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="5" Text="{Binding VolumePath}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!-- 3. Recovery -->
    <DataTemplate DataType="{x:Type vm:RecoveryViewModel}">
      <StackPanel>
        <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Target NTFS Volume or Raw Disk Image (Strictly Read-Only)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0"
                       Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                       Margin="0,0,8,0" />
              <Button Grid.Column="1"
                      Content="Browse Image..."
                      Command="{Binding BrowseImageCommand}"
                      Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <CheckBox Content="Include active (non-deleted) files in scan results"
                      IsChecked="{Binding IncludeActiveFiles}"
                      Foreground="{StaticResource TextSecondaryBrush}"
                      Margin="0,0,0,14" />

            <StackPanel Orientation="Horizontal">
              <Button Content="Start NTFS Quick Scan"
                      Command="{Binding StartNtfsQuickScanCommand}"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Margin="0,0,8,0" />
              <Button Content="Start Deep Scan (Carving)"
                      Command="{Binding StartDeepScanCommand}"
                      Style="{StaticResource SecondaryButtonStyle}"
                      Margin="0,0,8,0" />
              <Button Content="Partition Recovery (Phase 5)"
                      Style="{StaticResource SecondaryButtonStyle}"
                      IsEnabled="False" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource PanelBorderStyle}">
          <StackPanel>
            <TextBlock Text="SCAN STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Text="{Binding ScanStatusMessage}" Margin="0,6,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- 4. Scan Results -->
    <DataTemplate DataType="{x:Type vm:ScanResultsViewModel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filter & Action Bar -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filter by filename or reconstructed path"
                     Margin="0,0,8,0" />

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding ConfidenceFilters}"
                      SelectedItem="{Binding SelectedConfidenceFilter}"
                      Margin="0,0,8,0" />

            <Button Grid.Column="2"
                    Content="Safe Preview"
                    Command="{Binding PreviewSelectedCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" />

            <Button Grid.Column="3"
                    Content="Recover Selected File..."
                    Command="{Binding RecoverSelectedCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />
          </Grid>
        </Border>

        <!-- Results List + Metadata Inspector -->
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,6,0">
            <ListBox ItemsSource="{Binding FilteredFiles}"
                     SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="220" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="105" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding SizeFormatted}" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Confidence}" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding FullPath}" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Margin="6,0,0,0">
            <StackPanel>
              <TextBlock Text="FILE METADATA &amp; CONFIDENCE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
              <TextBlock Text="{Binding SelectedFile.FileName, FallbackValue='Select a file to inspect metadata'}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
              <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6">
                <Run Text="Path: " Foreground="{StaticResource TextMutedBrush}" />
                <Run Text="{Binding SelectedFile.FullPath, Mode=OneWay, FallbackValue='—'}" />
              </TextBlock>
              <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4">
                <Run Text="Size: " Foreground="{StaticResource TextMutedBrush}" />
                <Run Text="{Binding SelectedFile.SizeFormatted, Mode=OneWay, FallbackValue='—'}" />
              </TextBlock>
              <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4">
                <Run Text="Storage: " Foreground="{StaticResource TextMutedBrush}" />
                <Run Text="{Binding SelectedFile.StorageKind, Mode=OneWay, FallbackValue='—'}" />
              </TextBlock>
              <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4">
                <Run Text="Modified UTC: " Foreground="{StaticResource TextMutedBrush}" />
                <Run Text="{Binding SelectedFile.ModifiedUtc, Mode=OneWay, FallbackValue='—'}" />
              </TextBlock>
              <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8">
                <Run Text="Alternate Streams: " Foreground="{StaticResource TextMutedBrush}" />
                <Run Text="{Binding SelectedFile.AdsDisplay, Mode=OneWay, FallbackValue='—'}" />
              </TextBlock>
              <TextBlock Text="Confidence Explanation" FontWeight="SemiBold" Margin="0,4,0,4" />
              <TextBlock Text="{Binding SelectedFile.ConfidenceReason, FallbackValue='—'}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

              <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <StackPanel>
                  <TextBlock Text="SAFE NON-EXECUTING PREVIEW" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                  <Image Source="{Binding PreviewImage}"
                         MaxHeight="150"
                         Stretch="Uniform"
                         Margin="0,0,0,6" />
                  <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                           IsReadOnly="True"
                           TextWrapping="Wrap"
                           MaxHeight="130"
                           VerticalScrollBarVisibility="Auto"
                           FontFamily="Consolas"
                           FontSize="11" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Bottom Status -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Margin="0,12,0,0" Padding="12,8">
          <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </Border>
      </Grid>
    </DataTemplate>

    <!-- 5. Disk Imaging -->
    <DataTemplate DataType="{x:Type vm:DiskImagingViewModel}">
      <Border Style="{StaticResource PanelBorderStyle}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="{Binding StatusBadge}" FontWeight="SemiBold" Foreground="{StaticResource StatusWarningBrush}" />
          <TextBlock Text="Raw Disk Imaging &amp; Verification" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,8" />
          <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />
          <Button Content="Create Raw Disk Image (Phase 6)" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- 6. Recovery History -->
    <DataTemplate DataType="{x:Type vm:RecoveryHistoryViewModel}">
      <StackPanel>
        <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="Persisted Scan Sessions" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" />
            </DockPanel>
            <TextBlock Text="No scan sessions recorded yet. Real scan sessions will be persisted to SQLite starting in Phase 3."
                       Foreground="{StaticResource TextMutedBrush}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ScanSessions.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding ScanSessions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                    <TextBlock>
                      <Run Text="{Binding TargetDisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                      <Run Text=" — " />
                      <Run Text="{Binding Status, Mode=OneWay}" />
                      <Run Text=" (" />
                      <Run Text="{Binding DiscoveredFileCount, Mode=OneWay}" />
                      <Run Text=" files)" />
                    </TextBlock>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- 7. Settings -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <Border Style="{StaticResource PanelBorderStyle}" VerticalAlignment="Top">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="Engine &amp; Storage Preferences" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

          <TextBlock Text="Sequential Read Buffer Size (MiB, 1–64)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
          <TextBox Text="{Binding ReadBufferSizeMb, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left" Margin="0,0,0,12" />

          <TextBlock Text="SQLite Metadata Database Location" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
          <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,16" />

          <StackPanel Orientation="Horizontal">
            <Button Content="Save Preferences" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" />
            <TextBlock Text="{Binding SaveStatusMessage}" Foreground="{StaticResource StatusSuccessBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- 8. About Salvus -->
    <DataTemplate DataType="{x:Type vm:AboutViewModel}">
      <Border Style="{StaticResource PanelBorderStyle}" VerticalAlignment="Top">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="pack://application:,,,/Assets/Salvus.png"
                   Width="80"
                   Height="80"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Margin="0,0,18,0" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding ProductName}" FontSize="24" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Tagline}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,4" />
              <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
          </StackPanel>

          <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <StackPanel>
              <TextBlock Margin="0,0,0,4">
                <Run Text="License: " Foreground="{StaticResource TextMutedBrush}" />
                <Run Text="{Binding License, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Margin="0,0,0,4">
                <Run Text="Platform: " Foreground="{StaticResource TextMutedBrush}" />
                <Run Text="{Binding Platform, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Margin="0,0,0,12">
                <Run Text="Recovery Engine: " Foreground="{StaticResource TextMutedBrush}" />
                <Run Text="{Binding EngineSummary, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Text="Data Integrity Commitments" FontWeight="SemiBold" Margin="0,4,0,6" />
              <TextBlock Text="• Source storage is opened strictly read-only during scanning." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
              <TextBlock Text="• Salvus never formats, repairs, or initializes storage devices automatically." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
              <TextBlock Text="• Recovered files are never written to the source device and never executed automatically." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
              <TextBlock Text="• No telemetry and no uploading of user data." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Left Navigation Rail -->
    <Border Grid.Column="0"
            Background="{StaticResource BgSidebarBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- Brand Header -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,18,16,16">
          <Image Source="pack://application:,,,/Assets/Salvus.png"
                 Width="28"
                 Height="28"
                 Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 Margin="0,0,10,0"
                 VerticalAlignment="Center" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="SALVUS" FontSize="14" FontWeight="Bold" />
            <TextBlock Text="Data Recovery" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
        </StackPanel>

        <!-- Bottom Status Indicator -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{StaticResource StatusWarningBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEngineOnline}" Value="True">
                      <Setter Property="Fill" Value="{StaticResource StatusSuccessBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding EngineStatusSummary}"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <!-- Navigation List -->
        <ListBox ItemsSource="{Binding NavigationItems}"
                 SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="8,4">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="12,9" />
              <Setter Property="Margin" Value="0,1" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="NavBorder"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource BgSurfaceBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource BgSurfaceHoverBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Main Content Area -->
    <Grid Grid.Column="1" Margin="24,20,24,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,16">
        <TextBlock Text="{Binding CurrentSectionTitle}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding CurrentSectionSubtitle}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
      </StackPanel>

      <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
    </Grid>
  </Grid>
</Window>
