<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Salvus.Desktop</RootNamespace>
    <AssemblyName>Salvus.Desktop</AssemblyName>
    <ApplicationIcon>..\Salvus.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Salvus.Shared\Salvus.Shared.csproj" />
    <ProjectReference Include="..\Salvus.Data\Salvus.Data.csproj" />
  </ItemGroup>

  <!-- Official Salvus branding assets linked directly from repository root without duplication -->
  <ItemGroup>
    <Resource Include="..\Salvus.ico" Link="Assets\Salvus.ico" />
    <Resource Include="..\Salvus.png" Link="Assets\Salvus.png" />
  </ItemGroup>

  <!-- Copy built native engine executable alongside desktop executable when available -->
  <ItemGroup Condition="Exists('..\Salvus.Engine\build\$(Configuration)\Salvus.Engine.exe')">
    <None Include="..\Salvus.Engine\build\$(Configuration)\Salvus.Engine.exe"
          Link="Salvus.Engine.exe"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\Salvus.Engine\build\$(Configuration)\Salvus.Engine.exe') AND Exists('..\Salvus.Engine\build\Release\Salvus.Engine.exe')">
    <None Include="..\Salvus.Engine\build\Release\Salvus.Engine.exe"
          Link="Salvus.Engine.exe"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Enforce mandatory official branding assets in repository root -->
  <Target Name="VerifyOfficialBrandingAssets" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('..\Salvus.ico')"
           Text="Mandatory official branding asset missing from repository root: Salvus.ico" />
    <Error Condition="!Exists('..\Salvus.png')"
           Text="Mandatory official branding asset missing from repository root: Salvus.png" />
  </Target>
</Project>
